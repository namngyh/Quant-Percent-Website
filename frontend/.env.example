# Local development defaults to deterministic mock data.
DATA_MODE=mock
# Client components need to know the mode too (freshness labels).
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_AUTH_MODE=mock

# Server Components call FastAPI through this private/internal address when
# DATA_MODE=api. In Docker production this is http://api:8000.
API_BASE_URL=http://localhost:8000

# Leave empty for same-origin /api reverse proxy. Set only when the browser
# must call a dedicated API origin such as https://api.example.com.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CSRF_COOKIE_NAME=qp_csrf

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional notification used by the built-in mock contact route only.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
