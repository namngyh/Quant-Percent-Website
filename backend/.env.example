# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=dev
QP_DEBUG=false

# Origins allowed to call the API with session cookies (comma separated)
CORS_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------
# Use the least-privilege role created by scripts/create_role.sql, NOT the
# ingestion superuser. Inside Docker the host is the DB container name.
DATABASE_URL=postgresql+asyncpg://qp_web:change-me@localhost:5432/market

# --- Redis ----------------------------------------------------------------
# Database 1 keeps API keys apart from the ingestion pipeline on db 0
REDIS_URL=redis://localhost:6379/1

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set to the parent domain in production so api. and www. share the cookie
COOKIE_DOMAIN=
# Must be true whenever the site is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email (optional; submissions are stored either way) ------------------
RESEND_API_KEY=
EMAIL_FROM=Quant Percent <noreply@quantpercent.com>
CONTACT_NOTIFY_EMAIL=
PUBLIC_SITE_URL=http://localhost:3000

# --- Data publication -----------------------------------------------------
MARKET_DELAY_MINUTES=15
STALE_AFTER_MINUTES=90

# --- Docker compose (chỉ dùng khi chạy BE trong Docker) -------------------
API_PORT=8000
# Network do compose của Database-Onr-Percent tạo (<tên thư mục>_default)
QP_NETWORK=database-onr-percent_default
