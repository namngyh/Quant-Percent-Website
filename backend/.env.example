# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=dev
QP_DEBUG=false

# Origins allowed to call the API with session cookies (comma separated)
CORS_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------
# Use the least-privilege role created by scripts/create_role.sql, NOT the
# ingestion superuser. Inside Docker the host is the DB container name.
DATABASE_URL=postgresql+asyncpg://qp_web:change-me@localhost:5432/market

# --- Redis ----------------------------------------------------------------
# Database 1 keeps API keys apart from the ingestion pipeline on db 0
REDIS_URL=redis://localhost:6379/1

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set to the parent domain in production so api. and www. share the cookie
COOKIE_DOMAIN=
# Must be true whenever the site is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email (optional; submissions are stored either way) ------------------
# Chọn MỘT trong hai cách. Resend được ưu tiên nếu điền cả hai.
#
# Cách 1 — Resend: cần verify domain quantpercent.com bằng bản ghi DNS.
RESEND_API_KEY=
#
# Cách 2 — Gmail SMTP: không cần DNS, chỉ cần App Password của Google.
#   Bật xác thực 2 bước, rồi tạo App Password tại
#   https://myaccount.google.com/apppasswords
#   Dán 16 ký tự vào SMTP_PASSWORD (bỏ khoảng trắng cũng được).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true nếu dùng cổng 465 thay vì 587
SMTP_USE_SSL=false

# Với Gmail, địa chỉ gửi phải trùng SMTP_USER — backend tự thay nếu lệch.
EMAIL_FROM=Quant Percent <noreply@quantpercent.com>
CONTACT_NOTIFY_EMAIL=
PUBLIC_SITE_URL=http://localhost:3000

# --- Data publication -----------------------------------------------------
MARKET_DELAY_MINUTES=0
STALE_AFTER_MINUTES=90

# --- Docker compose (chỉ dùng khi chạy BE trong Docker) -------------------
API_PORT=8000
# Network do compose của repo database tạo: <tên thư mục>_default.
# Kiểm tra bằng `docker network ls`.
QP_NETWORK=database-quantpercent_default
