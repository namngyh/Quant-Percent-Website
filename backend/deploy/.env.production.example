DOMAIN=example.com

# Pin a tested immutable tag; never use `latest` in production.
TIMESCALE_IMAGE=timescale/timescaledb:<tested-version>-pg16
# Use three different URL-safe values. Generate each one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
QP_WEB_PASSWORD=replace-with-a-different-url-safe-password
JWT_SECRET=replace-with-a-third-url-safe-secret

# Leave blank for same-origin cookies. Use .example.com only if the API is
# intentionally moved to a separate subdomain later.
COOKIE_DOMAIN=

# Two transports; Resend wins if both are filled, so leave its key blank
# when using Gmail. Resend needs the sending domain verified in DNS.
RESEND_API_KEY=
# Gmail SMTP needs no DNS change. Turn on 2-step verification, create an
# App Password at https://myaccount.google.com/apppasswords and paste the
# 16 characters below. EMAIL_FROM must match SMTP_USER or Gmail rewrites it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quantpercent@gmail.com
SMTP_PASSWORD=
# true for port 465, which is TLS from the first byte
SMTP_USE_SSL=false

# Where inbound contact, feedback and join messages are delivered.
CONTACT_NOTIFY_EMAIL=quantpercent@gmail.com
EMAIL_FROM=Quant Percent <quantpercent@gmail.com>

MARKET_DELAY_MINUTES=0
STALE_AFTER_MINUTES=90
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
