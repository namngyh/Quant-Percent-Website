# --- Sao chép file này thành .env rồi điền giá trị thật ---

# DataPro (app DataPro.Client phải đang chạy — nó là API server, cổng 6789)
DATAPRO_API_KEY=your-datapro-api-key-here
# Container gọi DataPro.Client trên máy host qua host.docker.internal.
# Nếu DataPro chạy máy khác (LAN/VPN): http://<ip-may-do>:6789
# và bật "Cho phép kết nối từ ngoài" trong DataPro System Configuration.
DATAPRO_REST_URL=http://host.docker.internal:6789
# mock = dữ liệu giả lập để test pipeline | datapro = dữ liệu thật
DATAPRO_MODE=mock

# Mã ƯU TIÊN (bar phút refresh dày ~3s), phân tách bằng dấu phẩy
SYMBOLS=VN30F1M
# Mã theo dõi thêm (rổ VN30, chỉ số...): tick vẫn ~1s (quét bulk),
# bar phút quay vòng chậm hơn (~90s/mã với 30 mã). Nhớ cập nhật khi HOSE
# đảo rổ VN30 (tháng 1 và tháng 7 hằng năm).
STOCK_SYMBOLS=VN30INDEX,VNINDEX,ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MCH,MSN,MWG,POW,SAB,SHB,SSB,SSI,STB,TCB,TCX,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE

# PostgreSQL / TimescaleDB
POSTGRES_USER=quant
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=market
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Logging: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# Tùy chọn: chu kỳ poll (giây) — tổng phải dưới rate limit 2 req/s của DataPro
# SNAPSHOT_INTERVAL=1.0   (quét bulk snapshot: 1 request cho MỌI mã)
# BAR_SPACING=1.5         (giãn cách giữa 2 request bar phút)
