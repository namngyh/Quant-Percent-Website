# Copy to `.env` and fill in the password. `.env` is gitignored; this file is not,
# so never put a real password here.
#
# Team market database (QuantPercent): TimescaleDB / PostgreSQL 16 on the team
# VPS, read-only access to the `api` schema.
#
# Reachable only over the team VPN (Tailscale) — it does not listen on the
# public internet. A connection timeout or "could not translate host name"
# almost always means the VPN is off, not that anything is misconfigured.
#
# The host is 10.10.0.1, or the VPS's 100.x address if the team is on Tailscale.
MARKET_DSN=postgresql://qp_remote:PASSWORD_HERE@10.10.0.1:5432/market

# --- Thông báo Telegram (tuỳ chọn) ---
# Nhắn @BotFather trên Telegram để tạo bot và lấy token.
# Chat id: nhắn cho bot một câu rồi mở
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# và lấy giá trị message.chat.id.
# Bỏ trống thì nền tảng không gửi gì cả.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
