# DynamicGraph environment variables (copy to .env, never commit .env)
#
# Optional. If set, this overrides `data.database_path` from the YAML config.
# Accepts either a plain filesystem path or a SQLAlchemy-style URL.
#   sqlite:////absolute/path/to/database.db
#   duckdb:////absolute/path/to/database.duckdb
#   postgresql+psycopg://user:password@localhost:5432/dbname
#
# NOTE: the pipeline opens every source READ-ONLY and never writes to it.
DYNAMICGRAPH_DATABASE_URL=

# Optional root for generated artifacts (defaults to ./artifacts)
DYNAMICGRAPH_ARTIFACTS_DIR=

# Optional log level override (DEBUG|INFO|WARNING|ERROR)
DYNAMICGRAPH_LOG_LEVEL=
